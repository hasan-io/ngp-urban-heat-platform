# --- Nagpur UHI backend -------------------------------------------------
DATABASE_URL=sqlite:///./uhi.db          # production: postgresql+psycopg2://user:pass@host:5432/uhi
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
LOG_LEVEL=INFO
CACHE_TTL=300                            # seconds, satellite rasters
ANALYSIS_CACHE_TTL=1800                  # seconds, derived analytics
MAX_WORKERS=4
CORS_ORIGINS=*                           # e.g. http://localhost:5173,https://uhi.nagpur.gov.in
DATA_DIR=./data
IMAGERY_DIR=./data/satellite_imagery
MODELS_DIR=./data/models
LOGS_DIR=./logs
AUTO_PREPARE_DATA=true                   # build calibrated demo GeoTIFFs if none exist
AUTO_TRAIN_MODEL=true                    # train the XGBoost LST model on first start
ML_BACKEND=auto                          # auto | xgboost | sklearn
